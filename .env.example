# Copy to .env (which is gitignored) and adjust per laptop.
LLM_MODEL=llama3.2:1b      # CPU laptop: llama3.2:1b | demo laptop (RTX 2060): llama3.2:3b
LLM_TIMEOUT_SEC=3          # max seconds per alert before using the fixed message
# OLLAMA_HOST=http://127.0.0.1:11434   # only if Ollama runs on another machine/port
